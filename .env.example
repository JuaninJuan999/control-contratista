APP_NAME="Control Contratista"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
WORKBEEF_URL=http://192.168.20.205:8000/site.html

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

USABILIDAD_INACTIVIDAD_SEGUNDOS=900
USABILIDAD_CERRAR_SESION=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alertas planilla SS (fecha límite próxima a vencer)
ALERTAS_PLANILLA_HABILITADAS=true
# Días exactos antes del vencimiento en que se envía alerta (2 correos: 10 y 5 días)
ALERTAS_PLANILLA_DIAS_PROXIMA=10,5
# Días después del vencimiento para el único aviso de vigencia vencida
ALERTAS_PLANILLA_DIAS_VENCIDA=10
ALERTAS_PLANILLA_CORREOS_INTERNOS="siso@colbeef.com|aux.siso@colbeef.com|practicante.siso@colbeef.com"
ALERTAS_PLANILLA_HORA=07:00
ALERTAS_PLANILLA_ZONA=America/Bogota

# SMTP Colbeef (producción)
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=mail.colbeef.com.co
# MAIL_PORT=465
# MAIL_USERNAME=no-responder-sirt@colbeef.com.co
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-responder-sirt@colbeef.com.co
# MAIL_FROM_NAME="Sistema Reportes"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
